{
  "version": "1.183.11",
  "name": "achievers-admin",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "cross-env NODE_ENV=development node -r dotenv/config ./server.mjs",
    "start": "node --import @azure/monitor-opentelemetry/loader ./server.mjs",
    "format": "prettier --write .",
    "lint": "eslint",
    "seed": "prisma db seed",
    "setup": "prisma generate && prisma migrate deploy && prisma db seed",
    "test": "cross-env VITEST=true vitest",
    "test:ci": "prisma generate && vitest run --silent --coverage",
    "test:watch": "vitest dev",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:ui": "playwright test --project=chromium --ui",
    "typecheck": "react-router typegen && tsc",
    "prepare": "husky"
  },
  "dependencies": {
    "@azure/monitor-opentelemetry": "^1.21.0",
    "@azure/storage-blob": "^12.34.0",
    "@casl/ability": "^7.1.2",
    "@casl/prisma": "^2.2.0",
    "@lexical/react": "^0.53.0",
    "@mjackson/file-storage": "^0.7.0",
    "@mjackson/form-data-parser": "^0.9.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.221.0",
    "@opentelemetry/instrumentation": "^0.221.0",
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@prisma/instrumentation": "^7.10.1",
    "@react-router/express": "^8.5.1",
    "@react-router/node": "^8.5.1",
    "@tailwindcss/vite": "^4.3.5",
    "chart.js": "^4.6.1",
    "chartjs-plugin-datalabels": "^2.2.0",
    "classnames": "^2.5.1",
    "compression": "^1.8.2",
    "dayjs": "^1.11.23",
    "express": "^5.3.0",
    "iconoir-react": "^7.12.2",
    "isbot": "^5.2.3",
    "lexical": "^0.53.0",
    "morgan": "^1.12.1",
    "react": "^19.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "remix-auth": "^4.2.0",
    "remix-auth-oauth2": "^3.4.1",
    "source-map-support": "^0.5.21",
    "tiny-invariant": "^1.3.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint-react/eslint-plugin": "^5.30.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@react-router/dev": "^8.5.1",
    "@semantic-release/git": "^11.0.1",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/source-map-support": "^0.5.10",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "cross-env": "^10.1.0",
    "daisyui": "^5.7.50",
    "dotenv": "^18.0.10",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.5",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vitest-mock-extended": "^6.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/duvet86/achievers-admin.git"
  }
}
